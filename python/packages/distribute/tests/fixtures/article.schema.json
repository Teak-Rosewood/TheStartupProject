{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewsArticle as search engines need it (a subset of schema.org, plus the paywall properties)",
  "type": "object",
  "required": ["@context", "@type", "headline", "inLanguage", "datePublished", "dateModified", "author", "publisher", "mainEntityOfPage", "isAccessibleForFree"],
  "properties": {
    "@context": {"const": "https://schema.org"},
    "@type": {"enum": ["NewsArticle", "Article"]},
    "headline": {"type": "string", "minLength": 1, "maxLength": 110},
    "inLanguage": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"},
    "datePublished": {"type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d\\d-\\d\\dT"},
    "dateModified": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT"},
    "author": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["@type", "name"], "properties": {"@type": {"enum": ["Person", "Organization"]}, "name": {"type": "string", "minLength": 1}}}},
    "publisher": {"type": "object", "required": ["@type", "name"]},
    "mainEntityOfPage": {"type": "object", "required": ["@id"], "properties": {"@id": {"type": "string", "pattern": "^https?://"}}},
    "isAccessibleForFree": {"type": "boolean"},
    "image": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}}
  },
  "if": {"properties": {"isAccessibleForFree": {"const": false}}},
  "then": {
    "required": ["hasPart"],
    "properties": {"hasPart": {"type": "object", "required": ["isAccessibleForFree", "cssSelector"], "properties": {"isAccessibleForFree": {"const": false}, "cssSelector": {"type": "string", "minLength": 1}}}}
  }
}
